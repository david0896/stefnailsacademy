    "@tanstack/react-query": "5.76.1",
    "bcryptjs": "2.4.3",
    "clsx": "2.1.1",
    "googleapis": "148.0.0",
    "next": "15.3.9",
    "next-auth": "4.24.11",
    "nodemailer": "6.10.1",
    "prisma": "5.22.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-hook-form": "7.56.4",
    "react-icons": "5.4.0",
    "sharp": "0.33.5",
    "zod": "3.24.4"
  },
  "prisma": {
    "seed": "node prisma/seed.mjs"
  },
  "devDependencies": {
    "@eslint/eslintrc": "3.2.0",
