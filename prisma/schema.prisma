// =============================================
// Stef Nails Academy — Backoffice Schema
// DB: PostgreSQL (local pgAdmin / Supabase prod)
// =============================================

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// =============================================
// ADMIN USER — Login del backoffice (NextAuth)
// =============================================
model AdminUser {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admin_users")
}

// =============================================
// COURSE — Cursos (PRESENCIAL u ONLINE)
// =============================================
model Course {
  id              String       @id @default(cuid())
  title           String
  description     String
  type            CourseType
  status          CourseStatus @default(DRAFT)
  priceEUR        Float
  maxSpots        Int?
  date            DateTime?
  imageUrl        String?
  imageVariants   Json?
  nivel           CourseLevel?
  horasAcademicas Int?
  diasDeClases    Int?
  instructor      String?
  sede            String?
  deletedAt       DateTime?
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  enrollments Enrollment[]

  @@map("courses")
}

// =============================================
// STUDENT — Alumnos registrados
// =============================================
model Student {
  id              String           @id @default(cuid())
  firstName       String
  lastName        String
  email           String           @unique
  phone           String?
  idNumber        String?
  city            String?
  state           String?
  country         String           @default("Venezuela")
  experienceLevel ExperienceLevel?
  password        String?
  deletedAt       DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  enrollments Enrollment[]

  @@map("students")
}

// =============================================
// ENROLLMENT — Inscripciones
// =============================================
model Enrollment {
  id              String           @id @default(cuid())
  courseId        String
  studentId       String
  status          EnrollmentStatus @default(PENDING)
  paymentMethod   PaymentMethod
  paymentStatus   PaymentStatus    @default(PENDING)
  amountEUR       Float
  // Snapshot de la tasa BCV EUR del día del pago (Bs por 1 EUR) y el monto
  // convertido a Bs en ese momento. Capturados al crear la inscripción.
  // Permiten mostrar al admin "€5.00 ≈ Bs 1.250" con la tasa del PAGO,
  // no la del día en que el admin abre el detalle.
  // Pueden ser null para inscripciones viejas o si la API de tasa falló.
  bcvEurRate      Float?
  amountBs        Float?
  bankName        String?
  referenceNumber String?
  proofImageUrl   String?
  // Comprobante de pago optimizado (WebP responsive). Guarda PATHS dentro
  // del bucket privado 'comprobantes' (no URLs públicas — las signed URLs
  // se generan on-demand en el BO). Shape:
  //   { base, width, height, sizes: { "400": path, "800": path, ... } }
  paymentProofVariants Json?
  notes           String?
  enrolledAt      DateTime         @default(now())
  confirmedAt     DateTime?
  deletedAt       DateTime?
  updatedAt       DateTime         @updatedAt

  course  Course  @relation(fields: [courseId], references: [id])
  student Student @relation(fields: [studentId], references: [id])

  @@map("enrollments")
}

// =============================================
// GENERIC — Catálogos genéricos (bancos, estados, niveles, etc.)
// =============================================
// Tabla de listas de referencia. Cada categoría agrupa items relacionados
// (ej: category="BANK_VE" para bancos venezolanos). Se consulta vía
// GET /api/generics/:category. Editable manualmente desde la DB por ahora;
// si en el futuro hace falta editar desde el BO, se monta un CRUD.
model Generic {
  id        String   @id @default(cuid())
  category  String   // Ej: "BANK_VE", "STATE_VE", etc.
  code      String   // Identificador estable dentro de la categoría (ej: código SUDEBAN "0134" para Banesco)
  label     String   // Nombre legible (ej: "Banesco Banco Universal")
  order     Int      @default(0)   // Orden de display dentro de la categoría
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([category, code])
  @@index([category, active])
  @@map("generics")
}

// =============================================
// CONTENT — Contenido editable del sitio
// =============================================
model Content {
  id        String      @id @default(cuid())
  key       String      @unique
  value     String
  type      ContentType @default(TEXT)
  updatedAt DateTime    @updatedAt

  @@map("contents")
}

// =============================================
// ENUMS
// =============================================
enum CourseType {
  PRESENCIAL
  ONLINE
}

enum CourseStatus {
  DRAFT
  ACTIVE
  INACTIVE
}

enum CourseLevel {
  PRINCIPIANTE
  MEDIO
  AVANZADO
  MASTER
}

enum ExperienceLevel {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

enum EnrollmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
}

enum PaymentMethod {
  TRANSFER
  GATEWAY
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
}

enum ContentType {
  TEXT
  IMAGE
  JSON
}
