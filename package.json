  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "node -e \"if(process.env.DATABASE_URL&&process.env.DIRECT_URL){require('child_process').execSync('npx prisma migrate deploy',{stdio:'inherit'})}else{console.log('[build] DATABASE_URL/DIRECT_URL no seteadas, omitiendo migrate deploy')}\" && next build",
